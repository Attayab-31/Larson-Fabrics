# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Public API base URL used by the browser build.
# Local full-stack dev can leave this empty because the app defaults to /api.
# For Vercel frontend + Render backend, set this in Vercel to:
# https://YOUR-RENDER-SERVICE.onrender.com/api
VITE_API_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MANAGER_SECRET: Passcode for /manager admin access.
# Change this in production; do not use the server fallback passcode.
MANAGER_SECRET="CHANGE_ME_TO_A_STRONG_MANAGER_PASSCODE"

# MONGODB_URI: Connection string for real MongoDB Atlas persistence.
# If omitted, Larson defaults to high-performance JSON-backed file filesystem persistence.
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/larson_fabrics?retryWrites=true&w=majority"

# Optional Cloudinary image upload configuration for review/product images.
# Use either CLOUDINARY_URL or the three separate values below.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Render provides PORT automatically. Keep this only for local testing.
PORT="3000"
