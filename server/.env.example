# Larson Fabrics — Server environment variables
# Copy to .env and fill in values. NEVER commit .env to Git.

PORT=5000
NODE_ENV=development

# Comma-separated allowed front-end origins (CORS)
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/larson-fabrics?retryWrites=true&w=majority

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — contact / inquiry emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@larsonfabrics.com
